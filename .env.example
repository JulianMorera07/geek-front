# Host:puerto del backend real (sin protocolo ni prefijo /api/v1 — eso lo
# arma el proxy interno en src/app/api/v1/[...path]/route.ts). La usan tanto
# las requests del servidor (Server Components) como las del cliente
# (React Query): ambas piden siempre la ruta relativa /api/v1, que ese Route
# Handler reenvía hacia http://${BACKEND_INTERNAL_HOST}/api/v1/*.

BACKEND_INTERNAL_HOST=localhost:8000

# Tamaño de página usado internamente para traer TODOS los episodios de un
# anime desde GET /anime/:id/episodes (paginado por el backend desde este
# cambio) — se piden páginas de este tamaño en secuencia y se concatenan
# antes de mostrar la lista, así la UI sigue mostrando el listado completo.
# Necesita el prefijo NEXT_PUBLIC_: esta lógica corre en el navegador, y
# Next.js solo mete en el bundle del cliente las env vars con ese prefijo.
NEXT_PUBLIC_EPISODES_FETCH_PAGE_SIZE=50

# Token de solo lectura de GitHub — usado por src/app/download/geekbaku.apk/route.ts
# para bajar el .apk del TWA de Android desde el release "android-latest" del
# repo (privado, por eso hace falta auth) y servirlo desde nuestro propio
# dominio en vez de mandar a la gente a github.com. NUNCA se expone al
# cliente — el fetch pasa por ese Route Handler, server-side.
# Generarlo en GitHub → Settings → Developer settings → Fine-grained tokens,
# con permiso "Contents: Read-only" scopeado SOLO a este repo.
GITHUB_RELEASE_TOKEN=
